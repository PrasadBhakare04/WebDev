<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Details</title>
</head>

<body>
    <h1>
        Welcome to edit page
    </h1>
    <form action="/products/<%= foundProduct._id%>?_method=PUT" method="POST">
        <label for="#name">Enter Name</label>
        <input type="text" id="name" name="name" value=<%=foundProduct.name%>>

        <label for="#name">Price(Unit)</label>
        <input type="number" id="price" name="price" value=<%=foundProduct.price%>>

        <label for="#category">Select Category</label>
        <select name="category" id="category">
            <% for(let category of categories) {%>
                <option value="<%= category%>" <%=foundProduct.category===category ? 'selected' : '' %>><%= category%>
                </option>
                <% } %>
        </select>

        <button type="submit">Submit</button>
    </form>
    <a href="/products/<%= foundProduct._id%>">Cancel
    </a>

</body>

</html>