<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Details</title>
</head>

<body>
    <h1>
        <%= product.name %>
    </h1>
    <ul>
        <li>Price : <%= product.price%>
        </li>
        <li>Category : <a href="/products?category=<%= product.category%>">
                <%= product.category%>
            </a>
        </li>
    </ul>
    <h2>Visit Farm <a href="/farms/<%=product.farm._id%>">
            <%= product.farm.title%>
        </a></h2>
    <a href="/products">All List</a>
    <a href="/products/<%=product._id%>/edit">Edit Details</a>

    <form action="/products/<%= product._id%>?_method=DELETE" method="POST">
        <button>Delete</button>
    </form>
</body>

</html>